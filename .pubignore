# Build artifacts. When .pubignore exists, pub IGNORES .gitignore, so these
# defaults must be restated here.
# 当存在 .pubignore 时 pub 不再读取 .gitignore，因此这些默认忽略项必须在此声明。
.dart_tool/
build/
*.g.dart
*.freezed.dart
/pubspec.lock

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Dev-only tooling (EOL normalizer, release checker) is not shipped.
# 仅开发期使用的工具（LF 归一化、发布检查）不随包发布。
tool/

# Tests are not part of the published API surface.
# 测试不属于已发布 API 的一部分。
test/
