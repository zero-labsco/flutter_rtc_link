# Enforce LF line endings for all text files in this repository.
* text=auto eol=lf

# Explicitly treat these as text (even without extension hints).
*.dart text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.gradle text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.podspec text eol=lf
*.properties text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf

# Documentation site. / 文档站。
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Binary files must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bin binary
*.pdf binary
